{
    "skrapa": {
        "output": "../dist",
        "assets": "../public",
        "port": 8675,
        "origin": "https://local.iambrian.com"
    },
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "jsx": "react",
        "jsxFactory": "jsx",
        "jsxFragmentFactory": "Fragment",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "./.skrapa",
        "rootDir": "./",
        "lib": ["DOM", "DOM.Iterable", "ES2020"],
        // index.tsx renders in node and reads process.env; TS 6 no longer picks
        // up @types/node without being told.
        "types": ["node"]
    },
    "include": ["**/*.ts", "**/*.tsx", "skrapa.d.ts", "global.d.ts"],
    "exclude": ["node_modules", "dist", ".skrapa"]
}
